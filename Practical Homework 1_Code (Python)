import pandas as pd
import numpy as np

# Loading the data
data = pd.read_csv("C:\\Users\\mehek\\OneDrive\\Desktop\\Project 1- STML2\\youth_data.csv")
print(list(data.columns))
print("Initial shape:", data.shape)

# Removing duplicate rows
duplicates = data.duplicated().sum()
print(f"\nDuplicate rows: {duplicates}")
if duplicates > 0:
    data.drop_duplicates(inplace=True)
    print("\nNew shape of the datsser after removing the duplicates:", data.shape)

# Variables to focus on
selected_cols = ['IRCIGFM', 'IRALCFM', 'IRMJFM', 'IRSEX', 'NEWRACE2', 'INCOME',
                 'SCHFELT', 'PRPYRTO', 'PRXYRTO', 'PRIRDUC', 'IRALCEVER', 'IRMJEVER']

# Unique values in variables (before cleaning)
print("\nUnique values in selected variables (before cleaning):")
for col in selected_cols:
