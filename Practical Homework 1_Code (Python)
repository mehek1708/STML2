        print(f"{col} ({len(data[col].unique())} values): {data[col].unique()}")

'''This step is added after the cleaning process for getting results for classification'''
data['CIG_USED'] = data['IRCIGFM'].apply(
    lambda x: 0 if x == 91 else 1 if not pd.isna(x) and x not in [93, 94, 97, 98, 99] else np.nan
)
'''End of the added step'''

# Handling special codes ( replacing them with NaN)
special_codes = [
    91, 93, 94, 97, 98, 99,
    81, 83, 85, 89,
    991, 993, 994, 997, 998, 999,
    981, 983, 985, 989, 9991, 9993, 9994, 9997, 9998, 9999]

for col in ['IRCIGFM', 'IRALCFM', 'IRMJFM', 'IRALCEVER', 'IRMJEVER']:
    if col in data.columns:
        data[col] = data[col].replace(special_codes, np.nan)

# Human-readable mapping for categorical variables
if 'IRSEX' in data.columns:
    data['IRSEX'] = data['IRSEX'].replace({1: 'Male', 2: 'Female'})

race_map = {
    1: 'White', 2: 'Black', 3: 'Native American', 4: 'Asian',
    5: 'Pacific Islander', 6: 'Multiracial', 7: 'Other'
}
if 'NEWRACE2' in data.columns:
    data['NEWRACE2'] = data['NEWRACE2'].replace(race_map)

# Dropping columns with higher amount of missing data
imp_cols = ['IRCIGFM', 'IRALCFM', 'IRMJFM']
missing_ratio = data.isnull().mean()
to_drop = [col for col in missing_ratio[missing_ratio > 0.4].index if col not in imp_cols]
data.drop(columns=to_drop, inplace=True)
print(f"\nDropped columns with >40% missing (excluding targets): {to_drop}")
# Reason: Used this method instead of the one below, to avoid dropping target variables.

